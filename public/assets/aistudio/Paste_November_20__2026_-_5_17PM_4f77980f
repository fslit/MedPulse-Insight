    .detail-kv strong { font-size: 15px; color: #fff; margin-top: 2px; display: block; }

    /* ================== 平板与移动端深度适配 ================== */
    @media (max-width: 1120px) {
      .hero-grid {
        grid-template-columns: 1fr 1fr;
      }
      .stage-wrapper {
        grid-column: 1 / -1;
        order: -1; /* 平板与手机上将3D核心交互区放在最上方 */
        min-height: 520px;
      }
      .system-grid { grid-template-columns: repeat(3, 1fr); }
      .mid-grid { grid-template-columns: 1fr; }
      .plan-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 767px) {
      .container { padding: 0 12px 36px; }
      .navbar-inner { padding: 10px 12px; flex-wrap: wrap; }
      .nav-links { order: 3; width: 100%; padding-top: 6px; border-top: 1px solid rgba(56, 189, 248, 0.1); }
      .brand-sub { display: none; }

      .report-header { margin: 14px 0; }
      .hero-grid { grid-template-columns: 1fr; gap: 14px; }

      /* 移动端 3D 容器优化 */
      .stage-wrapper { min-height: auto; border-radius: 18px; }
      .canvas-area { min-height: 360px; height: 360px; }

      /* 移动端隐藏左右两侧悬浮卡片，防止遮挡3D人物，保留圆点热点 + 底部快捷芯片栏 */
      #organ-labels-layer,
      #leader-svg { display: none !important; }
