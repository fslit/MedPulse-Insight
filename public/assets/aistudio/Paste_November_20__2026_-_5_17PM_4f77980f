    .sys-score small { font-size: 12px; font-weight: 500; color: #cbd5e1; margin-left: 2px; }

    /* 影像 + 趋势双栏 */
    .mid-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 18px;
      margin-top: 18px;
    }

    .imaging-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .img-card {
      background: rgba(8, 20, 44, 0.85);
      border: 1px solid rgba(56, 189, 248, 0.18);
      border-radius: 14px;
      overflow: hidden;
      cursor: pointer;
      transition: border-color 0.2s;
    }
