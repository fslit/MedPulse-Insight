      g1.addColorStop(0, '#fb923c'); g1.addColorStop(0.55, '#9d174d'); g1.addColorStop(1, '#04091a');
      c1.fillStyle = g1; c1.fillRect(0, 0, 220, 130);
      c1.fillStyle = 'rgba(254, 240, 138, 0.75)';
      for (let i = 0; i < 65; i++) {
        c1.beginPath();
        c1.arc(40 + Math.random() * 140, 25 + Math.random() * 80, Math.random() * 1.8, 0, Math.PI * 2);
        c1.fill();
      }

      // 胃镜黏膜纹理预览
      const c2 = document.getElementById('img-stomach').getContext('2d');
      const g2 = c2.createRadialGradient(140, 50, 8, 110, 65, 110);
      g2.addColorStop(0, '#fca5a5'); g2.addColorStop(0.45, '#dc2626'); g2.addColorStop(1, '#450a0a');
      c2.fillStyle = g2; c2.fillRect(0, 0, 220, 130);
      c2.strokeStyle = 'rgba(254,202,202,0.35)'; c2.lineWidth = 4;
      for (let i = 0; i < 5; i++) {
        c2.beginPath();
        c2.moveTo(20, 20 + i * 22);
        c2.bezierCurveTo(80, 10 + i * 20, 140, 40 + i * 18, 200, 25 + i * 22);
        c2.stroke();
      }

      // 肠镜腔道预览
      const c3 = document.getElementById('img-colon').getContext('2d');
      const g3 = c3.createRadialGradient(110, 65, 6, 110, 65, 100);
      g3.addColorStop(0, '#2b0909'); g3.addColorStop(0.35, '#991b1b'); g3.addColorStop(0.8, '#ea580c'); g3.addColorStop(1, '#431407');
      c3.fillStyle = g3; c3.fillRect(0, 0, 220, 130);
      c3.strokeStyle = 'rgba(253,186,116,0.28)'; c3.lineWidth = 3;
      [22, 38, 56, 76].forEach(r => {
        c3.beginPath(); c3.arc(110, 65, r, 0, Math.PI * 2); c3.stroke();
      });
    }

    // 导航栏切换态
    document.querySelectorAll('.nav-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.nav-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
