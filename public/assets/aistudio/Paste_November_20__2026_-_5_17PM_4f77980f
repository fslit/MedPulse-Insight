    function createFresnelMaterial(colorHex = 0x1ea7ff, opacity = 0.42) {
      return new THREE.ShaderMaterial({
        uniforms: {
          uColor: { value: new THREE.Color(colorHex) },
          uTime: { value: 0 },
          uOpacity: { value: opacity }
        },
        vertexShader: `
          varying vec3 vNormal;
          varying vec3 vViewPos;
          varying vec3 vWorldPos;
          void main() {
            vNormal = normalize(normalMatrix * normal);
            vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
            vViewPos = -mvPosition.xyz;
            vWorldPos = (modelMatrix * vec4(position, 1.0)).xyz;
            gl_Position = projectionMatrix * mvPosition;
          }
        `,
        fragmentShader: `
          uniform vec3 uColor;
          uniform float uTime;
          uniform float uOpacity;
          varying vec3 vNormal;
          varying vec3 vViewPos;
          varying vec3 vWorldPos;
          void main() {
            vec3 normal = normalize(vNormal);
            vec3 viewDir = normalize(vViewPos);
            float fresnel = pow(1.0 - abs(dot(normal, viewDir)), 2.2);
            float scan = 0.85 + 0.15 * sin(vWorldPos.y * 38.0 - uTime * 3.0);
            float alpha = clamp((fresnel * 0.92 + 0.08) * uOpacity * scan, 0.03, 0.9);
            gl_FragColor = vec4(uColor * (1.0 + fresnel * 0.7), alpha);
          }
        `,
        transparent: true,
        depthWrite: false,
        side: THREE.DoubleSide,
        blending: THREE.AdditiveBlending
      });
    }

