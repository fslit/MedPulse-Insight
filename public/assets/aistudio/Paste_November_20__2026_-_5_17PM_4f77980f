      .system-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 10px;
        padding-bottom: 4px;
      }
      .system-card {
        min-width: 150px;
        flex-shrink: 0;
        scroll-snap-align: start;
      }

      .imaging-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 10px;
      }
      .img-card {
        min-width: 210px;
