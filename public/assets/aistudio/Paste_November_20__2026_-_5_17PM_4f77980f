    // ==================== 6. 交互式 SVG 趋势图 ====================
    function renderTrendChart() {
      const data = [
        { m: '6月', bp: 143, lip: 6.1, wt: 78.0 },
        { m: '7月', bp: 135, lip: 5.7, wt: 77.2 },
        { m: '8月', bp: 134, lip: 5.8, wt: 76.9 },
        { m: '9月', bp: 138, lip: 5.9, wt: 76.5 },
        { m: '10月', bp: 141, lip: 5.7, wt: 76.0 },
        { m: '11月', bp: 142, lip: 5.8, wt: 76.2 }
      ];
      const svg = document.getElementById('trend-svg');
      const W = 500, H = 185, padL = 36, padR = 36, padT = 18, padB = 26;
      const plotW = W - padL - padR, plotH = H - padT - padB;

      const xAt = i => padL + (i / (data.length - 1)) * plotW;
      const yBP = v => padT + (1 - (v - 100) / 60) * plotH;
      const yLip = v => padT + (1 - (v - 4.0) / 3.5) * plotH;
      const yWt = v => padT + (1 - (v - 60) / 30) * plotH;

      let html = '';
      // 水平参考线 & 左右刻度
      [100, 120, 140, 160].forEach((val, idx) => {
        const y = yBP(val);
        html += `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="rgba(148,163,184,0.14)" stroke-dasharray="3,3"/>`;
        html += `<text x="${padL - 8}" y="${y + 4}" text-anchor="end" fill="#64748b" font-size="10">${val}</text>`;
        html += `<text x="${W - padR + 8}" y="${y + 4}" text-anchor="start" fill="#64748b" font-size="10">${60 + idx * 10}</text>`;
      });

      const makeLine = (fn, color) => {
        const pts = data.map((d, i) => `${xAt(i)},${fn(d)}`).join(' ');
        const circles = data.map((d, i) =>
          `<circle cx="${xAt(i)}" cy="${fn(d)}" r="3.8" fill="#061329" stroke="${color}" stroke-width="2.2"/>`
        ).join('');
        return `<polyline fill="none" stroke="${color}" stroke-width="2.2" points="${pts}"/>${circles}`;
      };

      html += makeLine(d => yBP(d.bp), '#38bdf8');
      html += makeLine(d => yLip(d.lip), '#f59e0b');
      html += makeLine(d => yWt(d.wt), '#a78bfa');

      // X 轴月份 + 交互热区列
      html += `<line id="hover-guide" x1="${xAt(5)}" y1="${padT}" x2="${xAt(5)}" y2="${H - padB}" stroke="rgba(56,189,248,0.45)" stroke-dasharray="3,3"/>`;
      data.forEach((d, i) => {
        const x = xAt(i);
        html += `<text x="${x}" y="${H - 7}" text-anchor="middle" fill="#94a3b8" font-size="11">${d.m}</text>`;
        html += `<rect x="${x - 32}" y="${padT}" width="64" height="${plotH}" fill="transparent" style="cursor:pointer" data-idx="${i}"/>`;
      });

      svg.innerHTML = html;

      svg.querySelectorAll('rect[data-idx]').forEach(rect => {
        const updateTip = () => {
          const i = Number(rect.dataset.idx);
          const d = data[i];
          document.getElementById('hover-guide').setAttribute('x1', xAt(i));
          document.getElementById('hover-guide').setAttribute('x2', xAt(i));
          document.getElementById('tt-month').textContent = d.m;
          document.getElementById('tt-bp').textContent = d.bp;
          document.getElementById('tt-lip').textContent = d.lip;
          document.getElementById('tt-wt').textContent = d.wt;
        };
        rect.addEventListener('mouseenter', updateTip);
        rect.addEventListener('click', updateTip);
      });
    }

    // ==================== 7. 医学影像 Canvas 程序化渲染 ====================
    function renderMedicalImages() {
