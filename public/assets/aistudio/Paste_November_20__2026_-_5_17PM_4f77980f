    .img-desc { font-size: 11px; color: var(--text-sub); line-height: 1.4; }

    /* 趋势图 */
    .chart-legend {
      display: flex;
      gap: 14px;
      font-size: 11px;
      color: #cbd5e1;
      flex-wrap: wrap;
      margin-bottom: 8px;
