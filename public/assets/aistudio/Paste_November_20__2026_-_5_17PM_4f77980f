    @keyframes popIn {
      from { opacity: 0; transform: translateY(18px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .sheet-handle {
      display: none;
      width: 40px;
      height: 4px;
      border-radius: 99px;
      background: rgba(148, 163, 184, 0.4);
      margin: -6px auto 14px;
