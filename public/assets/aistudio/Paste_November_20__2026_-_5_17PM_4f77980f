      // 肾脏
      const kidneyGroup = new THREE.Group();
      const kGeo = new THREE.CapsuleGeometry(0.038, 0.065, 8, 12);
      const kL = new THREE.Mesh(kGeo, makeMat(0x34d399, 0x059669));
      kL.position.set(-0.28, 0, 0);
      const kR = new THREE.Mesh(kGeo, makeMat(0x34d399, 0x059669));
      kR.position.set(0, 0, 0);
      kidneyGroup.add(kL, kR);
      registerOrgan('kidneys', kidneyGroup);

      // 骨骼/膝关节亮点
      const boneMesh = new THREE.Mesh(
        new THREE.CapsuleGeometry(0.042, 0.36, 8, 12),
        makeMat(0xbae6fd, 0x38bdf8)
      );
      registerOrgan('bone', boneMesh);

      // 下肢血管（风险高亮）
      const vascMesh = new THREE.Mesh(
        new THREE.CylinderGeometry(0.022, 0.018, 0.44, 12),
        makeMat(0xfb923c, 0xd97706)
      );
      registerOrgan('vascular', vascMesh);
    }

    function registerOrgan(id, obj) {
      const cfg = ORGAN_DATA[id];
      obj.position.set(...cfg.pos);
      obj.userData.organId = id;
      obj.traverse(child => { child.userData.organId = id; });
      humanGroup.add(obj);
      organMeshes[id] = obj;
    }

    // ==================== 3. 3D 坐标 -> 2D 浮窗与连线投影 ====================
    const labelEls = {};
    const lineEls = {};
    const hotspotEls = {};
    const chipEls = {};

    function buildOverlays() {
      Object.entries(ORGAN_DATA).forEach(([id, cfg]) => {
        // 桌面端两侧悬浮卡片
        const card = document.createElement('div');
        card.className = `organ-float-card ${cfg.warn ? 'warn' : ''}`;
        card.innerHTML = `
          <div class="organ-icon-box">${cfg.icon}</div>
          <div class="organ-meta">
            <h4>${cfg.name}</h4>
            <div class="organ-status ${cfg.warn ? 'warn' : 'ok'}">${cfg.warn ? '⚠' : '●'} ${cfg.status}</div>
          </div>
        `;
        card.addEventListener('click', () => window.focusOrgan(id));
        labelsLayer.appendChild(card);
        labelEls[id] = card;

        // SVG 牵引线
        const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
        poly.setAttribute('fill', 'none');
        poly.setAttribute('stroke', cfg.warn ? 'rgba(245,158,11,0.75)' : 'rgba(125,211,252,0.65)');
        poly.setAttribute('stroke-width', '1.4');
        leaderSvg.appendChild(poly);
        lineEls[id] = poly;

        // 3D 表面热区圆点
        const dot = document.createElement('div');
        dot.className = `hotspot-dot ${cfg.warn ? 'warn' : ''}`;
        dot.title = `${cfg.name} · ${cfg.status}`;
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          window.focusOrgan(id);
        });
        hotspotsLayer.appendChild(dot);
        hotspotEls[id] = dot;

        // 移动端底部快捷器官胶囊
        const chip = document.createElement('button');
        chip.className = `organ-chip ${cfg.warn ? 'warn' : ''}`;
        chip.innerHTML = `${cfg.icon} ${cfg.name}`;
        chip.addEventListener('click', () => window.focusOrgan(id));
        chipsContainer.appendChild(chip);
        chipEls[id] = chip;
      });
    }

    function updateProjectedOverlays() {
      const w = canvasArea.clientWidth;
      const h = canvasArea.clientHeight;
      const tmpV = new THREE.Vector3();

      Object.entries(ORGAN_DATA).forEach(([id, cfg]) => {
        const mesh = organMeshes[id];
        if (!mesh) return;

        mesh.getWorldPosition(tmpV);
        const worldPos = tmpV.clone();
        tmpV.project(camera);

        const sx = (tmpV.x * 0.5 + 0.5) * w;
        const sy = (-tmpV.y * 0.5 + 0.5) * h;

        // 更新热区圆点
        const dot = hotspotEls[id];
        dot.style.left = `${sx}px`;
        dot.style.top = `${sy}px`;

        // 仅在屏幕足够宽时更新牵引线和两侧卡片
        if (window.innerWidth >= 768) {
          const anchorWorld = worldPos.clone();
          // 固定锚点分布在人物左右两侧，避免旋转时卡片互相叠压
          const targetX = cfg.side === 'left' ? Math.max(12, w * 0.04) : Math.min(w - 142, w * 0.96 - 130);
          const card = labelEls[id];
          const cardH = 46;
          const targetY = Math.min(Math.max(sy - cardH / 2, 12), h - cardH - 12);

          card.style.left = `${targetX}px`;
          card.style.top = `${targetY}px`;

          const endX = cfg.side === 'left' ? targetX + 124 : targetX;
          const endY = targetY + cardH / 2;
          const midX = cfg.side === 'left' ? endX + 26 : endX - 26;

          lineEls[id].setAttribute('points', `${sx},${sy} ${midX},${endY} ${endX},${endY}`);
        }
      });
    }

    // ==================== 4. 交互与射线点击 ====================
    function setupInteraction() {
      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      let downPos = { x: 0, y: 0 };

      canvas.addEventListener('pointerdown', (e) => {
        downPos = { x: e.clientX, y: e.clientY };
      });

      canvas.addEventListener('pointerup', (e) => {
        const dist = Math.hypot(e.clientX - downPos.x, e.clientY - downPos.y);
        if (dist > 6) return; // 拖拽旋转不触发点击

        const rect = canvas.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(Object.values(organMeshes), true);
        if (hits.length > 0) {
          const id = hits[0].object.userData.organId;
          if (id) window.focusOrgan(id);
        }
      });

      // 悬停手型变化
      canvas.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(Object.values(organMeshes), true);
        canvas.style.cursor = hits.length > 0 ? 'pointer' : 'grab';
      });

      // 顶部模式切换
      document.querySelectorAll('.stage-tab').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.stage-tab').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const mode = btn.dataset.mode;
          if (mode === 'overview') {
            bodyShellMat.uniforms.uOpacity.value = 0.55;
            innerWireMat.opacity = 0.08;
          } else if (mode === 'systems') {
            bodyShellMat.uniforms.uOpacity.value = 0.26;
            innerWireMat.opacity = 0.14;
          } else {
            bodyShellMat.uniforms.uOpacity.value = 0.14;
            innerWireMat.opacity = 0.22;
          }
        });
      });

      // 控制按钮
      const btnAuto = document.getElementById('btn-autorotate');
      btnAuto.addEventListener('click', () => {
        autoRotate = !autoRotate;
        btnAuto.classList.toggle('active', autoRotate);
      });

      document.getElementById('btn-reset-cam').addEventListener('click', () => {
        selectedOrganId = null;
        camera.position.set(0, 0.35, 5.2);
        controls.target.set(0, 0.25, 0);
        humanGroup.rotation.y = 0;
        Object.values(labelEls).forEach(el => el.classList.remove('active'));
        Object.values(chipEls).forEach(el => el.classList.remove('active'));
      });

      // 移动端：允许用户一键临时禁用 OrbitControls 以顺畅滑动长页面
      const btnScrollLock = document.getElementById('btn-scroll-lock');
      const syncMobileBtn = () => {
        btnScrollLock.style.display = window.innerWidth < 768 ? 'inline-block' : 'none';
      };
      syncMobileBtn();
      window.addEventListener('resize', syncMobileBtn);

      btnScrollLock.addEventListener('click', () => {
        const enabled = !controls.enabled;
        controls.enabled = enabled;
        canvas.style.touchAction = enabled ? 'none' : 'pan-y';
        btnScrollLock.textContent = enabled ? '允许滑屏' : '恢复3D拖拽';
        btnScrollLock.classList.toggle('active', !enabled);
      });

      // 自适应 ResizeObserver
      new ResizeObserver(() => {
        const w = canvasArea.clientWidth;
        const h = canvasArea.clientHeight;
        if (!w || !h) return;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }).observe(canvasArea);
    }

    function animate() {
      requestAnimationFrame(animate);
      const t = clock.getElapsedTime();

      bodyShellMat.uniforms.uTime.value = t;

      if (autoRotate) {
        humanGroup.rotation.y += 0.0045;
      }

      // 心脏76BPM跳动 & 肺部呼吸动效
      if (organMeshes.heart) {
        const beat = 1 + 0.09 * Math.pow(Math.max(0, Math.sin(t * 4.2)), 4);
        organMeshes.heart.scale.set(0.95 * beat, 1.15 * beat, 0.85 * beat);
      }
      if (organMeshes.lungs) {
        const breath = 1 + 0.045 * Math.sin(t * 1.8);
        organMeshes.lungs.scale.set(breath, breath, breath);
      }

      if (pedestalGroup) {
        pedestalGroup.children[1].rotation.z = t * 0.6;
      }

      controls.update();
      renderer.render(scene, camera);
      updateProjectedOverlays();
    }

    // ==================== 5. 弹窗与外部调用 API ====================
    window.focusOrgan = (id) => {
